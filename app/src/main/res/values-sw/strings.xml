    <!-- Battery optimization -->
    <string name="battery_optimization_detected">Kuweka Betri Kumegunduliwa</string>
    <string name="battery_optimization_disabled">Kuweka Betri Kumezimwa</string>
    <string name="battery_optimization_why_disable">Kwa nini uzime kuweka betri?</string>
    <string name="battery_optimization_explanation">Incognito Kenya inafanya kazi chinichini ili kudumisha muunganisho na vifaa vilivyo karibu. Kuweka betri kunaweza kukatisha muunganisho huu, na ujumbe ukachelewa au ukosekane.\n\nKuzima kuweka betri kunahakikisha ujumbe unafika kwa uhakika.</string>
    <string name="battery_optimization_disable_button">Zima Kuweka Betri</string>
    <string name="battery_optimization_note">Kumbuka: Unaweza kubadilisha hili baadaye kwenye Mipangilio ya Android &gt; Programu &gt; Incognito Kenya &gt; Betri</string>
    <string name="battery_optimization_success_message">Incognito Kenya sasa itafanya kazi vizuri chinichini</string>
    <string name="battery_optimization_benefits">• Ujumbe unafika kwa uhakika\n• Muunganisho unadumu\n• Programu inatuma ujumbe hata ukiwa huiangali\n• Hakuna kukatika ghafla</string>
    <string name="battery_optimization_check_again">Angalia Tena</string>
    <string name="battery_optimization_skip">Ruka kwa Sasa</string>
    <string name="battery_optimization_continue">Endelea</string>
    <string name="battery_optimization_detected_title">Kuweka Betri Kumegunduliwa</string>
    <string name="battery_optimization_enabled_title">Kuweka Betri Kumewashwa</string>
    <string name="battery_optimization_explanation_short">Incognito Kenya inahitaji kuendelea kufanya kazi chinichini ili kudumisha muunganisho na vifaa vilivyo karibu. Kuweka betri kunaweza kukatisha muunganisho huu.</string>
    <string name="benefits_of_disabling">Faida zake</string>
    <string name="battery_benefits_short">• Ujumbe unafika kwa uhakika\n• Muunganisho unadumu\n• Hakuna kukatika ghafla</string>
