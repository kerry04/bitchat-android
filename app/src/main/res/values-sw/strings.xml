    <!-- Onboarding -->
    <string name="location_services_required">Huduma za Eneo Zinahitajika</string>
    <string name="privacy_first">Faragha Kwanza</string>
    <string name="location_explanation">Incognito Kenya haifuatilii eneo lako — linabaki kwenye simu yako.\n\nHuduma za eneo zinahitajika kwa sababu Android inazihitaji ili kuchunguza Bluetooth. Ndiyo njia pekee ya kuwapata watu walio karibu bila intaneti.</string>
    <string name="location_needs_for">Incognito Kenya inahitaji huduma za eneo kwa ajili ya:</string>
    <string name="location_needs_bullets">• Kuchunguza vifaa vya Bluetooth vilivyo karibu\n• Kuwapata watu walio karibu kwenye mtandao\n• Kipengele cha chaneli za maeneo\n• Hatukusanyi wala kuhifadhi eneo lako</string>
    <string name="background_location_required_title">Eneo Chinichini Inapendekezwa</string>
    <string name="background_location_required_subtitle">Si lazima, lakini inaboresha muunganisho</string>
    <string name="background_location_explanation">Android inapendekeza ruhusa hii ili Incognito Kenya iweze kuchunguza vifaa vilivyo karibu hata programu ikiwa imefungwa. Hii huuweka mtandao hai hata baada ya kuwasha upya simu.</string>
    <string name="background_location_settings_tip">Mipangilio ikifunguka, chagua \"Ruhusu kila wakati\".</string>
    <string name="background_location_privacy_note">Eneo lako halitoki kwenye simu yako. Linatumika tu kutafuta watu walio karibu.</string>
    <string name="grant_background_location">Ruhusu Eneo Chinichini</string>
    <string name="skip_background_location">Endelea bila hiyo</string>
    <string name="open_location_settings">Fungua Mipangilio ya Eneo</string>
    <string name="check_again">Angalia Tena</string>
    <string name="bluetooth_required">Bluetooth Inahitajika</string>
    <string name="bluetooth_needs_for">Incognito Kenya inahitaji Bluetooth ili:</string>
    <string name="bluetooth_needs_bullets">• Kuwapata watu walio karibu\n• Kuunda mtandao wa ujumbe\n• Kutuma na kupokea ujumbe\n• Kufanya kazi bila intaneti wala seva</string>
    <string name="enable_bluetooth">Washa Bluetooth</string>
    <string name="bluetooth_not_supported">Bluetooth Haitumiki</string>
    <string name="bluetooth_unsupported_explanation">Kifaa hiki hakitumii Bluetooth Low Energy (BLE), ambayo inahitajika ili Incognito Kenya ifanye kazi.\n\nIncognito Kenya inahitaji BLE kuunda mitandao na kuwasiliana na watu walio karibu bila intaneti.</string>
    <string name="privacy_protected">Faragha Yako Imelindwa</string>
    <string name="privacy_bullets">• Hakuna ufuatiliaji wala ukusanyaji wa data\n• Mazungumzo ya Bluetooth yako nje ya intaneti kabisa</string>
